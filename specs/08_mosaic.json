{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/accommodation_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "NightsM": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Share within selected categories (percent)",
            "values": [
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "grid": false,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "format": ".0%"
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "AccommodationType",
          "type": "nominal",
          "scale": {
            "domain": [
              "Hotels and similar",
              "Rented accommodation",
              "Caravan and commercial camping",
              "Friends or relatives property"
            ],
            "range": [
              "#8FB4C8",
              "#2B5D73",
              "#536A85",
              "#C97868"
            ]
          },
          "legend": {
            "title": null,
            "labelFontSize": {
              "expr": "width < 400 ? 9 : 10"
            },
            "titleFontSize": 12,
            "columns": {
              "expr": "width < 400 ? 2 : 4"
            },
            "labelLimit": 100,
            "labelExpr": "datum.label === 'Hotels and similar' ? ['Hotels and', 'similar'] : datum.label === 'Rented accommodation' ? ['Rented', 'accommodation'] : datum.label === 'Caravan and commercial camping' ? ['Caravan and', 'commercial camping'] : ['Friends or', 'relatives property']",
            "gridAlign": "each",
            "columnPadding": 10,
            "clipHeight": 40,
            "symbolSize": 64,
            "labelLineHeight": 12,
            "labelOffset": 3,
            "rowPadding": 8
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "AccommodationType",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "NightsM",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ".2f"
          },
          {
            "field": "StateSelectedTotalM",
            "type": "quantitative",
            "title": "Recorded nights in selected categories (millions)",
            "format": ".2f"
          },
          {
            "field": "SharePct",
            "type": "quantitative",
            "title": "Share within state (percent)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontWeight": 600,
        "fontSize": {
          "expr": "(datum.x1 - datum.x0) * width < 45 ? 9 : 11"
        },
        "lineBreak": "\n",
        "lineHeight": 10,
        "dy": {
          "expr": "(datum.x1 - datum.x0) * width < 24 ? -4 : 0"
        }
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "LabelY",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "reverse": true,
            "nice": false
          }
        },
        "text": {
          "field": "ShareLabel"
        },
        "color": {
          "condition": {
            "test": "contrast('white', scale('color', datum.AccommodationType)) > contrast('#111111', scale('color', datum.AccommodationType))",
            "value": "white"
          },
          "value": "#111111"
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "AccommodationType",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "NightsM",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ".2f"
          },
          {
            "field": "StateSelectedTotalM",
            "type": "quantitative",
            "title": "Recorded nights in selected categories (millions)",
            "format": ".2f"
          },
          {
            "field": "SharePct",
            "type": "quantitative",
            "title": "Share within state (percent)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x0",
              "as": "StateX0"
            },
            {
              "op": "max",
              "field": "x1",
              "as": "StateX1"
            }
          ],
          "groupby": [
            "State"
          ]
        },
        {
          "calculate": "(datum.StateX0 + datum.StateX1) / 2",
          "as": "LabelX"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "normal",
        "angle": -45,
        "align": "right",
        "baseline": "middle",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "value": 412
        },
        "text": {
          "field": "State",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domainColor": "#888888",
      "tickColor": "#888888",
      "labelColor": "#444444",
      "titleColor": "#444444",
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif",
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "orient": "bottom",
      "direction": "horizontal",
      "titleAnchor": "start",
      "layout": {
        "bottom": {
          "anchor": "start"
        }
      },
      "offset": 82,
      "columnPadding": 24,
      "labelLimit": 240
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "description": "Mosaic of domestic visitor nights in four selected accommodation categories. State columns are ordered by their recorded totals, highest to lowest. Width is proportional to the total recorded nights in these categories; each block label shows its within-state percentage. Rented accommodation is deep blue, consistent with Figure 6.",
  "transform": [
    {
      "calculate": "indexof([\"Hotels and similar\", \"Rented accommodation\", \"Caravan and commercial camping\", \"Friends or relatives property\"], datum.AccommodationType)",
      "as": "CategoryOrder"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "NightsM",
          "as": "StateSelectedTotalM"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "stack": "NightsM",
      "groupby": [],
      "sort": [
        {
          "field": "StateSelectedTotalM",
          "order": "descending"
        },
        {
          "field": "State",
          "order": "ascending"
        },
        {
          "field": "CategoryOrder",
          "order": "ascending"
        }
      ],
      "offset": "normalize",
      "as": [
        "SegmentX0",
        "SegmentX1"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "SegmentX0",
          "as": "x0"
        },
        {
          "op": "max",
          "field": "SegmentX1",
          "as": "x1"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "stack": "NightsM",
      "groupby": [
        "State"
      ],
      "sort": [
        {
          "field": "CategoryOrder",
          "order": "ascending"
        }
      ],
      "offset": "normalize",
      "as": [
        "y0",
        "y1"
      ]
    },
    {
      "calculate": "(datum.y1 - datum.y0) * 100",
      "as": "SharePct"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "LabelX"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "LabelY"
    },
    {
      "calculate": "(datum.x1 - datum.x0) * width < 24 ? format(datum.SharePct, '.0f') + '\\n%' : format(datum.SharePct, (datum.x1 - datum.x0) * width < 30 ? '.0f' : '.1f') + '%'",
      "as": "ShareLabel"
    }
  ]
}
