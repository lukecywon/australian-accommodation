{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 400,
  "padding": {
    "left": 15,
    "right": 15,
    "top": 15,
    "bottom": 115
  },
  "data": {
    "url": "data/mosaic_rectangles.csv",
    "format": {
      "type": "csv",
      "parse": {
        "NightsM": "number",
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number",
        "StateSelectedTotalM": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true,
            "nice": false
          },
          "axis": {
            "title": "Share within selected categories (percent)",
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "grid": false,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "AccommodationType",
          "type": "nominal",
          "scale": {
            "domain": [
              "Hotels and similar",
              "Rented accommodation",
              "Friends or relatives property"
            ],
            "range": [
              "#EEAA55",
              "#E65A58",
              "#4E7DAA"
            ]
          },
          "legend": {
            "title": "Accommodation type",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "AccommodationType",
            "type": "nominal",
            "title": "Accommodation type"
          },
          {
            "field": "NightsM",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ".2f"
          },
          {
            "field": "StateSelectedTotalM",
            "type": "quantitative",
            "title": "State selected total (millions)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x0",
              "as": "StateX0"
            },
            {
              "op": "max",
              "field": "x1",
              "as": "StateX1"
            }
          ],
          "groupby": [
            "State"
          ]
        },
        {
          "calculate": "(toNumber(datum.StateX0) + toNumber(datum.StateX1)) / 2",
          "as": "LabelX"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "normal",
        "angle": -45,
        "align": "right",
        "baseline": "middle",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "value": 412
        },
        "text": {
          "field": "State",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domainColor": "#888888",
      "tickColor": "#888888",
      "labelColor": "#444444",
      "titleColor": "#444444"
    }
  }
}
