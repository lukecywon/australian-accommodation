{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "data": {
    "url": "data/spending_waterfall.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Order": "number",
        "ChangeM": "number",
        "LowM": "number",
        "HighM": "number",
        "Start2025TotalM": "number",
        "End2026TotalM": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "Step",
      "type": "ordinal",
      "sort": [
        "Accommodation",
        "Shopping / gifts",
        "Long-distance transport",
        "Alcohol / drinks",
        "Package tours",
        "Other (net)*",
        "Total increase"
      ],
      "axis": {
        "title": null,
        "labelAngle": -40,
        "labelFontSize": 10,
        "labelLimit": 160
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "LowM",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              620
            ],
            "nice": false
          },
          "axis": {
            "title": [
              "Change from June 2025 baseline",
              "(millions of Australian dollars)"
            ],
            "grid": true,
            "format": ",.0f"
          }
        },
        "y2": {
          "field": "HighM"
        },
        "color": {
          "field": "Kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increase",
              "Decrease",
              "Total"
            ],
            "range": [
              "#138878",
              "#CF5B59",
              "#405975"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "Step",
            "type": "nominal",
            "title": "Expenditure item"
          },
          {
            "field": "ChangeM",
            "type": "quantitative",
            "title": "Change (millions of Australian dollars)",
            "format": "+,.3f"
          },
          {
            "field": "Start2025TotalM",
            "type": "quantitative",
            "title": "2025 total (millions of Australian dollars)",
            "format": ",.3f"
          },
          {
            "field": "End2026TotalM",
            "type": "quantitative",
            "title": "2026 total (millions of Australian dollars)",
            "format": ",.3f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "baseline": "bottom",
        "fontSize": {
          "expr": "width < 400 ? 9 : 11"
        },
        "fontWeight": "bold",
        "color": "#233449"
      },
      "encoding": {
        "y": {
          "field": "HighM",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              620
            ],
            "nice": false
          },
          "axis": {
            "title": [
              "Change from June 2025 baseline",
              "(millions of Australian dollars)"
            ],
            "grid": true,
            "format": ",.0f"
          }
        },
        "text": {
          "field": "ChangeLabel",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#344054",
      "titleColor": "#344054",
      "gridColor": "#E6EAF0",
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "domain": false,
      "ticks": false
    },
    "font": "Segoe UI, Arial, sans-serif",
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
