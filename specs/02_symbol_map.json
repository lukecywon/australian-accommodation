{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 440,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia.topojson",
        "format": {
          "type": "topojson",
          "feature": "shapes"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME21 != 'Other Territories'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e7edf0",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/accommodation_spending.csv"
      },
      "mark": {
        "type": "circle",
        "fill": "#087e8b",
        "fillOpacity": 0.65,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "AccommodationSpendB",
          "type": "quantitative",
          "scale": {
            "range": [
              140,
              3300
            ]
          },
          "title": [
            "Accommodation spending",
            "(billions of Australian dollars)"
          ],
          "legend": {
            "titleLimit": 360,
            "titleFontSize": 11,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "values": [
              2,
              4,
              6
            ],
            "columnPadding": 24
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "AccommodationSpendB",
            "type": "quantitative",
            "title": "Accommodation spend (billions of Australian dollars)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "orient": "bottom",
      "direction": "horizontal",
      "titleAnchor": "start",
      "layout": {
        "bottom": {
          "anchor": "start"
        }
      },
      "offset": 16
    }
  }
}
