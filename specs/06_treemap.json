{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "International visitor nights by accommodation type. All eleven tiles are labelled; compact labels are expanded in tooltips. Values are shown in millions. A coastal palette uses deep blue for rented properties, terracotta for friends or relatives, powder blue for hotels and sand or neutral coastal tones for the remaining categories.",
  "width": "container",
  "height": 660,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/treemap_rectangles.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Nights2026M": "number",
        "SharePct": "number",
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number"
      }
    }
  },
  "transform": [
    {
      "lookup": "AccommodationType",
      "from": {
        "data": {
          "values": [
            {
              "AccommodationType": "Rented house/apartment/flat or unit",
              "ShortLabel": "Rented properties"
            },
            {
              "AccommodationType": "Friends or relatives property",
              "ShortLabel": "Friends or relatives"
            },
            {
              "AccommodationType": "Hotel/resort/motel or motor Inn",
              "ShortLabel": "Hotels, resorts\nand motels"
            },
            {
              "AccommodationType": "Other Private Accommodation",
              "ShortLabel": "Other private"
            },
            {
              "AccommodationType": "Backpacker or hostel",
              "ShortLabel": "Backpackers / hostels"
            },
            {
              "AccommodationType": "Other Accomodation(b)",
              "ShortLabel": "Other accommodation"
            },
            {
              "AccommodationType": "Own property",
              "ShortLabel": "Own property"
            },
            {
              "AccommodationType": "Other commercial accommodation",
              "ShortLabel": "Other\npaid"
            },
            {
              "AccommodationType": "Caravan park or commercial camping ground",
              "ShortLabel": "Caravan\npark"
            },
            {
              "AccommodationType": "Caravan or camping - non commercial",
              "ShortLabel": "Camping"
            },
            {
              "AccommodationType": "Guest house or Bed & Breakfast",
              "ShortLabel": "B&B"
            }
          ]
        },
        "key": "AccommodationType",
        "fields": [
          "ShortLabel"
        ]
      }
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "LabelX"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "LabelY"
    },
    {
      "calculate": "datum.ShortLabel + '\\n' + format(datum.Nights2026M, '.1f') + ' M'",
      "as": "TileLabel"
    }
  ],
  "encoding": {
    "tooltip": [
      {
        "field": "AccommodationType",
        "type": "nominal",
        "title": "Accommodation"
      },
      {
        "field": "Nights2026M",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "format": ".2f"
      },
      {
        "field": "SharePct",
        "type": "quantitative",
        "title": "Share (percent)",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "AccommodationType",
          "type": "nominal",
          "title": "Accommodation type",
          "legend": null,
          "scale": {
            "domain": [
              "Rented house/apartment/flat or unit",
              "Friends or relatives property",
              "Hotel/resort/motel or motor Inn",
              "Other Private Accommodation",
              "Backpacker or hostel",
              "Other Accomodation(b)",
              "Own property",
              "Other commercial accommodation",
              "Caravan park or commercial camping ground",
              "Caravan or camping - non commercial",
              "Guest house or Bed & Breakfast"
            ],
            "range": [
              "#2B5D73",
              "#C97868",
              "#8FB4C8",
              "#D6BD91",
              "#6E91AD",
              "#B2C0D0",
              "#A58F68",
              "#846F83",
              "#536A85",
              "#8E9196",
              "#D6D3CE"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "lineBreak": "\n",
        "fontSize": {
          "expr": "datum.y1 - datum.y0 < 5 ? 9 : (datum.x1 - datum.x0) * width / 100 < 90 ? 10 : (datum.x1 - datum.x0) * width / 100 < 200 ? 12 : 16"
        },
        "lineHeight": {
          "expr": "datum.y1 - datum.y0 < 5 ? 10 : (datum.x1 - datum.x0) * width / 100 < 90 ? 11 : (datum.x1 - datum.x0) * width / 100 < 200 ? 14 : 19"
        },
        "fontWeight": 600,
        "dy": {
          "expr": "-(length(split(datum.TileLabel, '\\n')) - 1) * (datum.y1 - datum.y0 < 5 ? 10 : (datum.x1 - datum.x0) * width / 100 < 90 ? 11 : (datum.x1 - datum.x0) * width / 100 < 200 ? 14 : 19) / 2 + 1"
        }
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": null
        },
        "y": {
          "field": "LabelY",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true,
            "nice": false
          },
          "axis": null
        },
        "text": {
          "field": "TileLabel"
        },
        "color": {
          "condition": {
            "test": "contrast('white', scale('color', datum.AccommodationType)) > contrast('#111111', scale('color', datum.AccommodationType))",
            "value": "#ffffff"
          },
          "value": "#111111"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  }
}
