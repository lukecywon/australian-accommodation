{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compare domestic and international visitor nights for eight Australian states and territories in the same year. Lines connect visitor markets, not years. Only label positions are adjusted to avoid collisions.",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/tourism_by_state_with_population.csv"
  },
  "transform": [
    {
      "fold": [
        "DomesticNightsM",
        "InternationalNightsM"
      ],
      "as": [
        "Market",
        "NightsM"
      ]
    },
    {
      "calculate": "datum.Market === 'DomesticNightsM' ? 0 : 1",
      "as": "MarketPosition"
    },
    {
      "calculate": "datum.State + '  ' + format(datum.NightsM, '.1f')",
      "as": "EndpointLabel"
    },
    {
      "calculate": "datum.MarketPosition === 0 ? (datum.StateCode === 'NT' ? 2 : datum.StateCode === 'ACT' ? 8 : datum.StateCode === 'TAS' ? 14 : datum.NightsM) : (datum.StateCode === 'TAS' ? 2 : datum.StateCode === 'NT' ? 8 : datum.StateCode === 'ACT' ? 14 : datum.StateCode === 'SA' ? 20 : datum.NightsM)",
      "as": "LabelNightsM"
    },
    {
      "calculate": "datum.MarketPosition === 0 ? -0.025 : 1.025",
      "as": "LabelX"
    },
    {
      "calculate": "datum.InternationalNightsM - datum.DomesticNightsM",
      "as": "MarketDifferenceM"
    }
  ],
  "encoding": {
    "x": {
      "field": "MarketPosition",
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.45,
          1.45
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "orient": "top",
        "values": [
          0,
          1
        ],
        "labelExpr": "datum.value === 0 ? 'Domestic visitor nights' : 'International visitor nights'",
        "labelAngle": 0,
        "labelPadding": 18,
        "labelFontSize": 14,
        "labelFont": "Segoe UI, Arial, sans-serif",
        "labelColor": "#183041",
        "grid": false,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "NightsM",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          125
        ],
        "nice": false
      },
      "axis": {
        "title": "Visitor nights (millions)",
        "values": [
          0,
          25,
          50,
          75,
          100,
          125
        ]
      }
    },
    "color": {
      "field": "StateCode",
      "type": "nominal",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT",
          "ACT"
        ],
        "range": [
          "#1e6484",
          "#b87926",
          "#7456a6",
          "#526d82",
          "#8C563D",
          "#9b6582",
          "#6F6B63",
          "#6079a6"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "State"
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "DomesticNightsM",
        "type": "quantitative",
        "title": "Domestic nights (millions)",
        "format": ".3f"
      },
      {
        "field": "InternationalNightsM",
        "type": "quantitative",
        "title": "International nights (millions)",
        "format": ".3f"
      },
      {
        "field": "MarketDifferenceM",
        "type": "quantitative",
        "title": "International minus domestic nights (millions)",
        "format": "+.3f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "stateHover",
        "empty": true,
        "value": 1
      },
      "value": 0.18
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 16,
        "opacity": 0,
        "cursor": "pointer"
      },
      "encoding": {
        "order": {
          "field": "MarketPosition"
        },
        "opacity": {
          "value": 0
        }
      },
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover[event.item && event.item.datum && event.item.datum.State]",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "order": {
          "field": "MarketPosition"
        },
        "strokeWidth": {
          "condition": {
            "param": "stateHover",
            "empty": false,
            "value": 4
          },
          "value": 2.5
        }
      }
    },
    {
      "mark": {
        "type": "circle"
      },
      "encoding": {
        "size": {
          "condition": {
            "param": "stateHover",
            "empty": false,
            "value": 150
          },
          "value": 85
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "encoding": {
        "x2": {
          "field": "LabelX"
        },
        "y2": {
          "field": "LabelNightsM"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative"
        },
        "y": {
          "field": "LabelNightsM",
          "type": "quantitative"
        },
        "text": {
          "field": "EndpointLabel"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MarketPosition === 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "LabelX",
          "type": "quantitative"
        },
        "y": {
          "field": "LabelNightsM",
          "type": "quantitative"
        },
        "text": {
          "field": "EndpointLabel"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'NSW' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0.36,
          "type": "quantitative"
        },
        "y": {
          "datum": 114.6262,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "datum": 0.36
        },
        "y2": {
          "datum": 121
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'NSW' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 55,
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0.36,
          "type": "quantitative"
        },
        "y": {
          "datum": 114.6262,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'NSW' && datum.MarketPosition === 0"
        },
        {
          "calculate": "0.17 + 1.9 * 320 / width",
          "as": "AnnotationRight"
        },
        {
          "calculate": "133 - 125 * 48 / height",
          "as": "AnnotationBottom"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#B6C6D0",
        "strokeWidth": 1,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "datum": 0.17,
          "type": "quantitative"
        },
        "y": {
          "datum": 133,
          "type": "quantitative"
        },
        "color": {
          "value": "#ffffff"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "field": "AnnotationRight"
        },
        "y2": {
          "field": "AnnotationBottom"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'NSW' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 10,
        "dy": 8,
        "fontSize": 11,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 0.17,
          "type": "quantitative"
        },
        "y": {
          "datum": 133,
          "type": "quantitative"
        },
        "color": {
          "value": "#183041"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "text": {
          "value": [
            "New South Wales leads both visitor markets:",
            "119.2 million domestic; 106.6 million international nights."
          ]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'QLD' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0.239631,
          "type": "quantitative"
        },
        "y": {
          "datum": 84.861788,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "datum": 0.4
        },
        "y2": {
          "datum": 86
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'QLD' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 55,
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0.239631,
          "type": "quantitative"
        },
        "y": {
          "datum": 84.861788,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'QLD' && datum.MarketPosition === 0"
        },
        {
          "calculate": "0.4 + 1.9 * 280 / width",
          "as": "AnnotationRight"
        },
        {
          "calculate": "106 - 125 * 80 / height",
          "as": "AnnotationBottom"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#B6C6D0",
        "strokeWidth": 1,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "datum": 0.4,
          "type": "quantitative"
        },
        "y": {
          "datum": 106,
          "type": "quantitative"
        },
        "color": {
          "value": "#ffffff"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "field": "AnnotationRight"
        },
        "y2": {
          "field": "AnnotationBottom"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'QLD' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 10,
        "dy": 8,
        "fontSize": 11,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 0.4,
          "type": "quantitative"
        },
        "y": {
          "datum": 106,
          "type": "quantitative"
        },
        "color": {
          "value": "#183041"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "text": {
          "value": [
            "Queensland and Victoria swap ranks 2 and 3.",
            "Queensland leads domestically by 5.5 million.",
            "Victoria leads internationally by 17.5 million.",
            "Queensland's 29.8 million-night gap is largest."
          ]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'WA' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0.64,
          "type": "quantitative"
        },
        "y": {
          "datum": 37.14992,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "datum": 0.4
        },
        "y2": {
          "datum": 44
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'WA' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 55,
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0.64,
          "type": "quantitative"
        },
        "y": {
          "datum": 37.14992,
          "type": "quantitative"
        },
        "color": {
          "value": "#526d82"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'WA' && datum.MarketPosition === 0"
        },
        {
          "calculate": "0.12 + 1.9 * 290 / width",
          "as": "AnnotationRight"
        },
        {
          "calculate": "60 - 125 * 64 / height",
          "as": "AnnotationBottom"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#B6C6D0",
        "strokeWidth": 1,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "datum": 0.12,
          "type": "quantitative"
        },
        "y": {
          "datum": 60,
          "type": "quantitative"
        },
        "color": {
          "value": "#ffffff"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "x2": {
          "field": "AnnotationRight"
        },
        "y2": {
          "field": "AnnotationBottom"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StateCode === 'WA' && datum.MarketPosition === 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 10,
        "dy": 8,
        "fontSize": 11,
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "datum": 0.12,
          "type": "quantitative"
        },
        "y": {
          "datum": 60,
          "type": "quantitative"
        },
        "color": {
          "value": "#183041"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null,
        "text": {
          "value": [
            "Only Western Australia and the Northern Territory",
            "record more international than domestic nights:",
            "2.5 million and 0.5 million more, respectively."
          ]
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFont": "Segoe UI, Arial, sans-serif",
      "labelColor": "#536575",
      "titleColor": "#183041",
      "gridColor": "#e2e9ef",
      "domain": false,
      "ticks": false,
      "titlePadding": 12,
      "labelFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  }
}
