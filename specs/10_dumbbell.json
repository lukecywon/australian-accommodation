{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/international_accommodation_comparison.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Nights2025M": "number",
        "Nights2026M": "number"
      }
    }
  },
  "params": [
    {
      "name": "focus",
      "value": "Selected accommodation types",
      "bind": {
        "input": "select",
        "name": "Display: ",
        "options": [
          "Selected accommodation types",
          "Smaller categories (under 15 million nights)"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "indexof(['Other commercial accommodation', 'Caravan park or commercial camping ground', 'Caravan or camping - non commercial', 'Guest house or Bed & Breakfast'], datum.AccommodationType) < 0"
    },
    {
      "lookup": "AccommodationType",
      "from": {
        "data": {
          "values": [
            {
              "AccommodationType": "Hotel/resort/motel or motor Inn",
              "DisplayAccommodation": "Hotels, resorts and motels"
            },
            {
              "AccommodationType": "Rented house/apartment/flat or unit",
              "DisplayAccommodation": "Rented properties"
            },
            {
              "AccommodationType": "Backpacker or hostel",
              "DisplayAccommodation": "Backpackers or hostels"
            },
            {
              "AccommodationType": "Own property",
              "DisplayAccommodation": "Own property"
            },
            {
              "AccommodationType": "Friends or relatives property",
              "DisplayAccommodation": "Friends or relatives"
            },
            {
              "AccommodationType": "Other Private Accommodation",
              "DisplayAccommodation": "Other private accommodation"
            },
            {
              "AccommodationType": "Other Accomodation(b)",
              "DisplayAccommodation": "Other accommodation"
            }
          ]
        },
        "key": "AccommodationType",
        "fields": [
          "DisplayAccommodation"
        ]
      }
    },
    {
      "calculate": "datum.Nights2026M - datum.Nights2025M",
      "as": "ChangeM"
    },
    {
      "calculate": "100 * (datum.Nights2026M / datum.Nights2025M - 1)",
      "as": "ChangePct"
    },
    {
      "filter": "focus === 'Selected accommodation types' || datum.Nights2026M < 15"
    }
  ],
  "encoding": {
    "y": {
      "field": "DisplayAccommodation",
      "type": "nominal",
      "sort": {
        "field": "Nights2026M",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 170,
        "labelFontSize": 11
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#B6C6D0"
      },
      "encoding": {
        "x": {
          "field": "Nights2025M",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "title": "Visitor nights (millions)"
        },
        "x2": {
          "field": "Nights2026M"
        },
        "tooltip": [
          {
            "field": "AccommodationType",
            "title": "Accommodation type"
          },
          {
            "field": "Nights2025M",
            "type": "quantitative",
            "title": "2025 (millions of nights)",
            "format": ".2f"
          },
          {
            "field": "Nights2026M",
            "type": "quantitative",
            "title": "2026 (millions of nights)",
            "format": ".2f"
          },
          {
            "field": "ChangeM",
            "type": "quantitative",
            "title": "Change (millions of nights)",
            "format": "+.2f"
          },
          {
            "field": "ChangePct",
            "type": "quantitative",
            "title": "Change (percent)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "Nights2025M",
            "Nights2026M"
          ],
          "as": [
            "YearField",
            "VisitorNightsM"
          ]
        },
        {
          "calculate": "datum.YearField === 'Nights2025M' ? '2025' : '2026'",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 100,
        "opacity": 1,
        "filled": true,
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "VisitorNightsM",
          "type": "quantitative",
          "scale": {
            "zero": true
          },
          "title": "Visitor nights (millions)"
        },
        "tooltip": [
          {
            "field": "AccommodationType",
            "title": "Accommodation type"
          },
          {
            "field": "Year",
            "title": "Year ending June"
          },
          {
            "field": "VisitorNightsM",
            "type": "quantitative",
            "title": "Visitor nights (millions)",
            "format": ".2f"
          },
          {
            "field": "ChangeM",
            "type": "quantitative",
            "title": "Change 2025\u00e2\u20ac\u201c2026 (millions)",
            "format": "+.2f"
          },
          {
            "field": "ChangePct",
            "type": "quantitative",
            "title": "Change 2025\u00e2\u20ac\u201c2026 (percent)",
            "format": "+.1f"
          }
        ],
        "stroke": {
          "field": "Year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2025",
              "2026"
            ],
            "range": [
              "#688FA5",
              "#35617D"
            ]
          },
          "legend": {
            "title": "Year ending June",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "titleAnchor": "middle",
            "symbolStrokeWidth": 2
          }
        },
        "fill": {
          "field": "Year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2025",
              "2026"
            ],
            "range": [
              "white",
              "#35617D"
            ]
          },
          "legend": {
            "title": "Year ending June",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "titleAnchor": "middle",
            "symbolStrokeWidth": 2
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#e6e9ee",
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "tickCount": 5,
      "labelFontSize": 11
    },
    "font": "Segoe UI, Arial, sans-serif",
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "layout": {
        "bottom": {
          "anchor": "middle"
        }
      }
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  }
}
