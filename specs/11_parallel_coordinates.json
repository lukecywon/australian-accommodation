{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 380,
  "data": {
    "url": "data/state_accommodation_economy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "OutputM": "number",
        "GVAM": "number",
        "FilledJobs000": "number",
        "ConsumptionM": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.GVAM / datum.FilledJobs000",
      "as": "GVAperJobK"
    },
    {
      "fold": [
        "OutputM",
        "FilledJobs000",
        "GVAperJobK",
        "ConsumptionM"
      ],
      "as": [
        "MetricKey",
        "Value"
      ]
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 'Output (millions of Australian dollars)' : datum.MetricKey === 'FilledJobs000' ? 'Filled jobs (thousands)' : datum.MetricKey === 'GVAperJobK' ? 'Gross value added per filled job (thousands of Australian dollars)' : 'Consumption (millions of Australian dollars)'",
      "as": "Metric"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "Value",
          "as": "MetricMin"
        },
        {
          "op": "max",
          "field": "Value",
          "as": "MetricMax"
        }
      ],
      "groupby": [
        "MetricKey"
      ]
    },
    {
      "calculate": "datum.MetricMax === datum.MetricMin ? 0.5 : (datum.Value - datum.MetricMin) / (datum.MetricMax - datum.MetricMin)",
      "as": "Normalised"
    }
  ],
  "encoding": {
    "x": {
      "field": "Metric",
      "type": "ordinal",
      "sort": [
        "Output (millions of Australian dollars)",
        "Filled jobs (thousands)",
        "Gross value added per filled job (thousands of Australian dollars)",
        "Consumption (millions of Australian dollars)"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelLimit": 290,
        "labelFontSize": 11,
        "labelLineHeight": 16,
        "labelExpr": "datum.label === 'Gross value added per filled job (thousands of Australian dollars)' ? ['Gross value added', 'per filled job', '(thousands of Australian dollars)'] : datum.label === 'Filled jobs (thousands)' ? ['Filled jobs', '(thousands)'] : [split(datum.label, ' (')[0], '(millions of Australian dollars)']"
      }
    },
    "y": {
      "field": "Normalised",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "title": "Relative value (0 = lowest state; 1 = highest state)",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "format": ".2f",
        "grid": true
      }
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "title": "State / territory",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "labelLimit": 300,
        "labelFontSize": 12,
        "title": "State or territory"
      }
    },
    "detail": {
      "field": "State"
    },
    "opacity": {
      "condition": {
        "param": "stateHover",
        "value": 1
      },
      "value": 0.13
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Metric",
        "type": "nominal",
        "title": "Indicator"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Original value (unit on axis)",
        "format": ",.2f"
      },
      {
        "field": "Normalised",
        "type": "quantitative",
        "title": "Relative position",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 40
      }
    }
  ]
}
