{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/state_accommodation_economy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "OutputM": "number",
        "GVAM": "number",
        "FilledJobs000": "number",
        "ConsumptionM": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "LabelRank"
        }
      ],
      "sort": [
        {
          "field": "ConsumptionM",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.GVAM / datum.FilledJobs000",
      "as": "GVAperJobK"
    },
    {
      "fold": [
        "OutputM",
        "FilledJobs000",
        "GVAperJobK",
        "ConsumptionM"
      ],
      "as": [
        "MetricKey",
        "Value"
      ]
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 'Output (millions of Australian dollars)' : datum.MetricKey === 'FilledJobs000' ? 'Filled jobs (thousands)' : datum.MetricKey === 'GVAperJobK' ? 'Gross value added per filled job (thousands of Australian dollars)' : 'Consumption (millions of Australian dollars)'",
      "as": "Metric"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "Value",
          "as": "MetricMin"
        },
        {
          "op": "max",
          "field": "Value",
          "as": "MetricMax"
        }
      ],
      "groupby": [
        "MetricKey"
      ]
    },
    {
      "calculate": "datum.MetricMax === datum.MetricMin ? 0.5 : (datum.Value - datum.MetricMin) / (datum.MetricMax - datum.MetricMin)",
      "as": "Normalised"
    }
  ],
  "encoding": {
    "x": {
      "field": "Metric",
      "type": "ordinal",
      "sort": [
        "Output (millions of Australian dollars)",
        "Filled jobs (thousands)",
        "Gross value added per filled job (thousands of Australian dollars)",
        "Consumption (millions of Australian dollars)"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelLimit": 290,
        "labelFontSize": 12,
        "labelLineHeight": 16,
        "labelExpr": "datum.label === 'Gross value added per filled job (thousands of Australian dollars)' ? ['Gross value added', 'per filled job'] : datum.label === 'Filled jobs (thousands)' ? 'Filled jobs' : split(datum.label, ' (')[0]",
        "labelPadding": 12
      },
      "scale": {
        "type": "point",
        "padding": 0
      }
    },
    "y": {
      "field": "Normalised",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "title": "Relative value (0 = lowest state; 1 = highest state)",
        "values": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "format": ".2f",
        "grid": true,
        "labelPadding": 8
      }
    },
    "color": {
      "field": "StateCode",
      "type": "nominal",
      "title": "State / territory",
      "legend": null,
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT",
          "ACT"
        ],
        "range": [
          "#1e6484",
          "#b87926",
          "#7456a6",
          "#526d82",
          "#427e77",
          "#9b6582",
          "#847540",
          "#6079a6"
        ]
      }
    },
    "detail": {
      "field": "State"
    },
    "opacity": {
      "condition": {
        "param": "stateHover",
        "value": 1
      },
      "value": 0.13
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Metric",
        "type": "nominal",
        "title": "Indicator and unit"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Original value",
        "format": ",.2f"
      },
      {
        "field": "Normalised",
        "type": "quantitative",
        "title": "Relative position",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "domain": false,
      "ticks": false
    },
    "legend": {
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 40
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MetricKey === 'ConsumptionM'"
        },
        {
          "calculate": "max(datum.Normalised, (datum.LabelRank - 1) * 0.055)",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "rule",
        "xOffset": 8,
        "strokeWidth": 1
      },
      "encoding": {
        "y2": {
          "field": "LabelY"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MetricKey === 'ConsumptionM'"
        },
        {
          "calculate": "max(datum.Normalised, (datum.LabelRank - 1) * 0.055)",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "State"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 175,
    "top": 10,
    "bottom": 5
  }
}
