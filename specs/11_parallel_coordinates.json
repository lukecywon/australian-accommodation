{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart of state and territory ranks across four accommodation economy indicators, financial year 2024\u20132025. Rank 1 is the highest value; indicators are not a time series.",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/state_accommodation_economy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "OutputM": "number",
        "GVAM": "number",
        "FilledJobs000": "number",
        "ConsumptionM": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.GVAM / datum.FilledJobs000",
      "as": "GVAperJobK"
    },
    {
      "fold": [
        "OutputM",
        "FilledJobs000",
        "GVAperJobK",
        "ConsumptionM"
      ],
      "as": [
        "MetricKey",
        "Value"
      ]
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 'Output (millions of Australian dollars)' : datum.MetricKey === 'FilledJobs000' ? 'Filled jobs (thousands)' : datum.MetricKey === 'GVAperJobK' ? 'Gross value added per filled job (thousands of Australian dollars)' : 'Consumption (millions of Australian dollars)'",
      "as": "Metric"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Value",
          "order": "descending"
        }
      ],
      "groupby": [
        "MetricKey"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "MetricKey",
      "type": "ordinal",
      "sort": [
        "OutputM",
        "FilledJobs000",
        "GVAperJobK",
        "ConsumptionM"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLineHeight": 16,
        "labelPadding": 14,
        "ticks": false,
        "domain": false,
        "labelExpr": "datum.label === 'OutputM' ? 'Output' : datum.label === 'FilledJobs000' ? 'Filled jobs' : datum.label === 'GVAperJobK' ? ['Gross value added', 'per filled job'] : 'Consumption'"
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "scale": {
        "domain": [
          1,
          8
        ],
        "reverse": true,
        "nice": false
      },
      "axis": {
        "title": "Rank (1 = highest value)",
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "format": "d",
        "domain": false,
        "ticks": false,
        "gridColor": "#e6e9ee"
      }
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "scale": {
        "domain": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "range": [
          "#332288",
          "#AA4499",
          "#117733",
          "#CC6677",
          "#225588",
          "#887722",
          "#882255",
          "#258577"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "State"
    },
    "opacity": {
      "condition": {
        "param": "stateHover",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "State",
        "title": "State or territory"
      },
      {
        "field": "Metric",
        "title": "Indicator and unit"
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "title": "Rank",
        "format": "d"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Original value",
        "format": ",.2f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.5
      }
    },
    {
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 95,
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MetricKey === 'ConsumptionM'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "State"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif"
  },
  "padding": {
    "left": 5,
    "right": 175,
    "top": 10,
    "bottom": 5
  }
}
