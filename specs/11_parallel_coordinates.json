{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/state_accommodation_economy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "OutputM": "number",
        "GVAM": "number",
        "FilledJobs000": "number",
        "ConsumptionM": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "LabelRank"
        }
      ],
      "sort": [
        {
          "field": "ConsumptionM",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.GVAM / datum.FilledJobs000",
      "as": "GVAperJobK"
    },
    {
      "fold": [
        "OutputM",
        "FilledJobs000",
        "GVAperJobK",
        "ConsumptionM"
      ],
      "as": [
        "MetricKey",
        "Value"
      ]
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 'Output (millions of Australian dollars)' : datum.MetricKey === 'FilledJobs000' ? 'Filled jobs (thousands)' : datum.MetricKey === 'GVAperJobK' ? 'Gross value added per filled job (thousands of Australian dollars)' : 'Consumption (millions of Australian dollars)'",
      "as": "Metric"
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 7000 : datum.MetricKey === 'FilledJobs000' ? 35 : datum.MetricKey === 'GVAperJobK' ? 120 : 8000",
      "as": "AxisMax"
    },
    {
      "calculate": "datum.MetricKey === 'OutputM' ? 1000 : datum.MetricKey === 'FilledJobs000' ? 5 : datum.MetricKey === 'GVAperJobK' ? 20 : 2000",
      "as": "TickStep"
    },
    {
      "calculate": "datum.Value / datum.AxisMax",
      "as": "PlotPosition"
    }
  ],
  "encoding": {
    "x": {
      "field": "Metric",
      "type": "ordinal",
      "sort": [
        "Output (millions of Australian dollars)",
        "Filled jobs (thousands)",
        "Gross value added per filled job (thousands of Australian dollars)",
        "Consumption (millions of Australian dollars)"
      ],
      "axis": null,
      "scale": {
        "type": "point",
        "padding": 0
      }
    },
    "y": {
      "field": "PlotPosition",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          1
        ],
        "nice": false
      },
      "axis": null
    },
    "color": {
      "field": "StateCode",
      "type": "nominal",
      "title": "State / territory",
      "legend": null,
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT",
          "ACT"
        ],
        "range": [
          "#1e6484",
          "#b87926",
          "#7456a6",
          "#526d82",
          "#8C563D",
          "#9b6582",
          "#6F6B63",
          "#6079a6"
        ]
      }
    },
    "detail": {
      "field": "State"
    },
    "opacity": {
      "condition": {
        "param": "stateHover",
        "value": 1
      },
      "value": 0.13
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Metric",
        "type": "nominal",
        "title": "Indicator and unit"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Original value",
        "format": ",.2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "domain": false,
      "ticks": false
    },
    "legend": {
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif"
  },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [],
          "groupby": [
            "MetricKey",
            "Metric",
            "AxisMax",
            "TickStep"
          ]
        },
        {
          "calculate": "0",
          "as": "AxisBottom"
        },
        {
          "calculate": "1",
          "as": "AxisTop"
        }
      ],
      "encoding": {
        "color": {
          "value": "#B6C2CB"
        },
        "detail": {
          "field": "MetricKey"
        },
        "opacity": {
          "value": 1
        },
        "tooltip": null
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "AxisBottom",
              "type": "quantitative"
            },
            "y2": {
              "field": "AxisTop"
            }
          }
        },
        {
          "transform": [
            {
              "calculate": "sequence(0, datum.AxisMax + datum.TickStep / 2, datum.TickStep)",
              "as": "Ticks"
            },
            {
              "flatten": [
                "Ticks"
              ],
              "as": [
                "TickValue"
              ]
            },
            {
              "calculate": "datum.TickValue / datum.AxisMax",
              "as": "TickPosition"
            }
          ],
          "encoding": {
            "y": {
              "field": "TickPosition",
              "type": "quantitative"
            }
          },
          "layer": [
            {
              "mark": {
                "type": "tick",
                "orient": "horizontal",
                "size": 6,
                "thickness": 1
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "dx": -9,
                "fontSize": 10
              },
              "encoding": {
                "text": {
                  "field": "TickValue",
                  "type": "quantitative",
                  "format": ","
                },
                "color": {
                  "value": "#536575"
                }
              }
            }
          ]
        },
        {
          "transform": [
            {
              "calculate": "datum.MetricKey === 'OutputM' ? 'Output\\n(millions of\\nAustralian dollars)' : datum.MetricKey === 'FilledJobs000' ? 'Filled jobs\\n(thousands)' : datum.MetricKey === 'GVAperJobK' ? 'Gross value added\\nper filled job\\n(thousands of\\nAustralian dollars)' : 'Consumption\\n(millions of\\nAustralian dollars)'",
              "as": "AxisHeader"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "dy": -90,
            "lineBreak": "\n",
            "lineHeight": 15,
            "fontSize": 11,
            "fontWeight": 500
          },
          "encoding": {
            "y": {
              "field": "AxisTop",
              "type": "quantitative"
            },
            "text": {
              "field": "AxisHeader"
            },
            "color": {
              "value": "#183041"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5
      }
    },
    {
      "params": [
        {
          "name": "stateHover",
          "select": {
            "type": "point",
            "fields": [
              "State"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 40
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MetricKey === 'ConsumptionM'"
        },
        {
          "calculate": "max(datum.PlotPosition, 0.035 + (datum.LabelRank - 1) * 0.055)",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "rule",
        "xOffset": 8,
        "strokeWidth": 1
      },
      "encoding": {
        "y2": {
          "field": "LabelY"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.MetricKey === 'ConsumptionM'"
        },
        {
          "calculate": "max(datum.PlotPosition, 0.035 + (datum.LabelRank - 1) * 0.055)",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "State"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 10,
    "bottom": 5
  },
  "description": "Parallel coordinates of four state accommodation economy indicators. Each vertical axis uses original units and its own zero-based scale. Axis limits are rounded above the observed maxima."
}
