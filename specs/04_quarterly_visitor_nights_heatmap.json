{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 304,
  "data": {
    "url": "data/quarterly_visitor_nights.csv",
    "format": {
      "type": "csv",
      "parse": {
        "VisitorNights000": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "VisitorNights000",
          "as": "StateAverage"
        }
      ],
      "groupby": [
        "State"
      ]
    },
    {
      "calculate": "(datum.VisitorNights000 / datum.StateAverage - 1) * 100",
      "as": "DeviationPct"
    },
    {
      "calculate": "replace(replace(replace(replace(datum.Quarter, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')",
      "as": "DisplayQuarter"
    },
    {
      "calculate": "abs(datum.DeviationPct) < 0.05 ? '0.0%' : format(datum.DeviationPct, '+.1f') + '%'",
      "as": "DeviationLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "Quarter",
      "type": "ordinal",
      "sort": [
        "Jun 2025",
        "Sep 2025",
        "Dec 2025",
        "Mar 2026",
        "Jun 2026"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 9,
        "labelExpr": "replace(replace(replace(replace(datum.label, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')",
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "title": null,
      "axis": {
        "labelLimit": 215,
        "labelPadding": 8,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "DeviationPct",
      "type": "quantitative",
      "title": "Difference from state average (percent)",
      "scale": {
        "scheme": "redblue",
        "domainMid": 0
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 340,
        "titleLimit": 450
      }
    },
    "tooltip": [
      {
        "field": "State",
        "title": "State"
      },
      {
        "field": "DisplayQuarter",
        "title": "Quarter"
      },
      {
        "field": "VisitorNights000",
        "type": "quantitative",
        "title": "Visitor nights (thousands)",
        "format": ",.0f"
      },
      {
        "field": "DeviationPct",
        "type": "quantitative",
        "title": "versus state average (percent)",
        "format": "+.1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "titleFontSize": 11,
      "labelFontSize": 11,
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "font": "Segoe UI, Arial, sans-serif"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "DeviationLabel",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "contrast('white', scale('color', datum.DeviationPct)) > contrast('#183041', scale('color', datum.DeviationPct))",
            "value": "#ffffff"
          },
          "value": "#183041"
        }
      }
    }
  ]
}
