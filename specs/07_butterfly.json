{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 270,
  "data": {
    "url": "data/accommodation_capital_regional.csv"
  },
  "transform": [
    {
      "calculate": "datum.Area === 'Capital' ? -datum.NightsM : datum.NightsM",
      "as": "SignedNights"
    },
    {
      "calculate": "datum.Area === 'Capital' ? 'Capital cities' : 'Regional Australia'",
      "as": "DisplayArea"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "SignedNights",
      "type": "quantitative",
      "scale": {
        "domain": [
          -85,
          85
        ]
      },
      "axis": {
        "title": "Visitor nights (millions)",
        "values": [
          -80,
          -60,
          -40,
          -20,
          0,
          20,
          40,
          60,
          80
        ],
        "labelExpr": "abs(datum.value)"
      }
    },
    "y": {
      "field": "AccommodationType",
      "type": "nominal",
      "sort": [
        "Hotels and similar",
        "Rented accommodation",
        "Caravan_commercial camping",
        "Friends or relatives property"
      ],
      "title": null
    },
    "color": {
      "field": "Area",
      "type": "nominal",
      "scale": {
        "domain": [
          "Capital",
          "Regional"
        ],
        "range": [
          "#3478ae",
          "#dc974a"
        ]
      },
      "title": "Area",
      "legend": {
        "labelExpr": "datum.label === 'Capital' ? 'Capital cities' : 'Regional Australia'"
      }
    },
    "tooltip": [
      {
        "field": "AccommodationType",
        "title": "Accommodation"
      },
      {
        "field": "DisplayArea",
        "title": "Area"
      },
      {
        "field": "NightsM",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  }
}
