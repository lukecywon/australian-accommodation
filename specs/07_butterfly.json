{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/accommodation_capital_regional.csv",
    "format": {
      "type": "csv",
      "parse": {
        "NightsM": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Area === 'Capital' ? -datum.NightsM : datum.NightsM",
      "as": "SignedNights"
    },
    {
      "calculate": "datum.Area === 'Capital' ? 'Capital cities' : 'Regional Australia'",
      "as": "DisplayArea"
    },
    {
      "calculate": "format(datum.NightsM, '.1f') + ' M'",
      "as": "NightsLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "SignedNights",
      "type": "quantitative",
      "scale": {
        "domainMin": {
          "expr": "-80 * width / max(width - 80, 1)"
        },
        "domainMax": {
          "expr": "80 * width / max(width - 80, 1)"
        },
        "nice": false
      },
      "axis": {
        "title": "Visitor nights (millions)",
        "values": [
          -80,
          -60,
          -40,
          -20,
          0,
          20,
          40,
          60,
          80
        ],
        "labelExpr": "abs(datum.value)"
      }
    },
    "y": {
      "field": "AccommodationType",
      "type": "nominal",
      "sort": [
        "Hotels and similar",
        "Rented accommodation",
        "Caravan_commercial camping",
        "Friends or relatives property"
      ],
      "title": null,
      "axis": {
        "labelLimit": 180,
        "labelFontSize": 11,
        "labelExpr": "datum.label === 'Caravan_commercial camping' ? ['Caravan and', 'commercial camping'] : datum.label === 'Friends or relatives property' ? ['Friends or relatives', 'property'] : datum.label === 'Rented accommodation' ? ['Rented', 'accommodation'] : datum.label",
        "labelAngle": -50,
        "labelAlign": "right",
        "labelBaseline": "middle",
        "labelPadding": 10
      }
    },
    "color": {
      "field": "Area",
      "type": "nominal",
      "scale": {
        "domain": [
          "Capital",
          "Regional"
        ],
        "range": [
          "#4056A1",
          "#B88726"
        ]
      },
      "title": "Area",
      "legend": {
        "labelExpr": "width < 350 ? (datum.label === 'Capital' ? ['Capital', 'cities'] : ['Regional', 'Australia']) : datum.label === 'Capital' ? 'Capital cities' : 'Regional Australia'",
        "columns": 2,
        "gridAlign": "each",
        "columnPadding": 12,
        "clipHeight": 40,
        "labelLimit": 150,
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "AccommodationType",
        "title": "Accommodation"
      },
      {
        "field": "DisplayArea",
        "title": "Area"
      },
      {
        "field": "NightsM",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "orient": "bottom",
      "direction": "horizontal",
      "titleAnchor": "start",
      "layout": {
        "bottom": {
          "anchor": "start"
        }
      },
      "offset": 16,
      "columnPadding": 24,
      "labelLimit": 240
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.Area === 'Capital' ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.Area === 'Capital' ? -6 : 6"
        },
        "baseline": "middle",
        "fontSize": 10,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "NightsLabel"
        },
        "color": {
          "condition": {
            "test": "datum.Area === 'Capital'",
            "value": "#4056A1"
          },
          "value": "#8B641C"
        }
      }
    }
  ]
}
