{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 350,
  "data": {
    "url": "data/purpose_by_quarter.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "Quarter",
      "type": "ordinal",
      "sort": [
        "Jun 2025",
        "Sep 2025",
        "Dec 2025",
        "Mar 2026",
        "Jun 2026"
      ],
      "title": "Quarter",
      "axis": {
        "labelAngle": 0,
        "labelExpr": "replace(replace(replace(replace(datum.label, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')"
      }
    },
    "y": {
      "field": "VisitorNightsM",
      "type": "quantitative",
      "title": "Visitor nights (millions)",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "Purpose",
      "type": "nominal",
      "title": "Purpose of travel"
    },
    "tooltip": [
      {
        "field": "Purpose",
        "type": "nominal"
      },
      {
        "field": "DisplayQuarter",
        "type": "ordinal",
        "title": "Quarter"
      },
      {
        "field": "VisitorNightsM",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  },
  "transform": [
    {
      "calculate": "replace(replace(replace(replace(datum.Quarter, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')",
      "as": "DisplayQuarter"
    }
  ]
}
