{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Four compact small-multiple panels compare travel purposes in one horizontal row, using shared scales and a colour-blind-friendly Okabe-Ito palette. All original data values and tooltips are retained.",
  "data": {
    "url": "data/purpose_by_quarter.csv"
  },
  "transform": [
    {
      "calculate": "replace(replace(replace(replace(datum.Quarter, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')",
      "as": "DisplayQuarter"
    }
  ],
  "facet": {
    "field": "Purpose",
    "type": "nominal",
    "sort": [
      "Holiday",
      "Visiting friends and relatives",
      "Business",
      "Other"
    ],
    "header": {
      "title": null,
      "labelOrient": "top",
      "labelAnchor": "start",
      "labelAlign": "left",
      "labelFontSize": 12,
      "labelFontWeight": 600,
      "labelPadding": 12
    }
  },
  "columns": 4,
  "spacing": {
    "column": 20,
    "row": 24
  },
  "spec": {
    "width": 295,
    "height": 180,
    "mark": {
      "type": "line",
      "strokeWidth": 2.5,
      "point": {
        "filled": true,
        "size": 65
      }
    },
    "encoding": {
      "x": {
        "field": "Quarter",
        "type": "ordinal",
        "sort": [
          "Jun 2025",
          "Sep 2025",
          "Dec 2025",
          "Mar 2026",
          "Jun 2026"
        ],
        "title": null,
        "axis": {
          "labelAngle": 0,
          "labelExpr": "split(replace(replace(replace(replace(datum.label, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March '), ' ')",
          "labelFontSize": 11,
          "labelLimit": 120,
          "labelPadding": 8,
          "labelLineHeight": 14
        }
      },
      "y": {
        "field": "VisitorNightsM",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "scale": {
          "domain": [
            0,
            55
          ],
          "nice": false
        },
        "axis": {
          "values": [
            0,
            10,
            20,
            30,
            40,
            50
          ],
          "grid": true
        }
      },
      "tooltip": [
        {
          "field": "Purpose",
          "type": "nominal"
        },
        {
          "field": "DisplayQuarter",
          "type": "ordinal",
          "title": "Quarter"
        },
        {
          "field": "VisitorNightsM",
          "type": "quantitative",
          "title": "Visitor nights (millions)",
          "format": ".2f"
        }
      ],
      "color": {
        "field": "Purpose",
        "type": "nominal",
        "scale": {
          "domain": [
            "Holiday",
            "Visiting friends and relatives",
            "Business",
            "Other"
          ],
          "range": [
            "#0072B2",
            "#D55E00",
            "#009E73",
            "#CC79A7"
          ]
        },
        "legend": null
      }
    }
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e2e9ef",
      "domainColor": "#b8c6d0",
      "tickColor": "#b8c6d0"
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "header": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  }
}
