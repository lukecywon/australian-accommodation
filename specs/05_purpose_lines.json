{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Responsive two-column small multiples in one Vega-Lite view. Panel coordinates position the four travel-purpose plots; both rows retain the same visitor-night scale. Original values and tooltips are unchanged.",
  "width": "container",
  "height": 470,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "data": {
    "url": "data/purpose_by_quarter.csv",
    "format": {
      "type": "csv",
      "parse": {
        "VisitorNightsM": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "replace(replace(replace(replace(datum.Quarter, 'Jun ', 'June '), 'Sep ', 'September '), 'Dec ', 'December '), 'Mar ', 'March ')",
      "as": "DisplayQuarter"
    },
    {
      "calculate": "datum.Purpose === 'Visiting friends and relatives' || datum.Purpose === 'Other' ? 4.6 : 0",
      "as": "PanelColumn"
    },
    {
      "calculate": "datum.Purpose === 'Holiday' || datum.Purpose === 'Visiting friends and relatives' ? 70 : 0",
      "as": "PanelBase"
    },
    {
      "calculate": "indexof(['Jun 2025', 'Sep 2025', 'Dec 2025', 'Mar 2026', 'Jun 2026'], datum.Quarter)",
      "as": "QuarterIndex"
    },
    {
      "calculate": "datum.PanelColumn + datum.QuarterIndex",
      "as": "PanelX"
    },
    {
      "calculate": "datum.PanelBase + datum.VisitorNightsM",
      "as": "PanelY"
    }
  ],
  "encoding": {
    "x": {
      "field": "PanelX",
      "type": "quantitative",
      "scale": {
        "domain": [
          -0.25,
          8.85
        ],
        "nice": false
      },
      "axis": {
        "title": null,
        "values": [
          0,
          1,
          2,
          3,
          4,
          4.6,
          5.6,
          6.6,
          7.6,
          8.6
        ],
        "labelExpr": "width < 650 && (round(datum.value >= 4.6 ? datum.value - 4.6 : datum.value) === 1 || round(datum.value >= 4.6 ? datum.value - 4.6 : datum.value) === 3) ? '' : [['June', 'September', 'December', 'March', 'June'][round(datum.value >= 4.6 ? datum.value - 4.6 : datum.value)], ['2025', '2025', '2025', '2026', '2026'][round(datum.value >= 4.6 ? datum.value - 4.6 : datum.value)]]",
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelLineHeight": 14,
        "labelPadding": 8,
        "labelOverlap": false,
        "grid": false,
        "labelAlign": {
          "expr": "width < 650 && datum.value === 4 ? 'right' : width < 650 && datum.value === 4.6 ? 'left' : 'center'"
        }
      }
    },
    "y": {
      "field": "PanelY",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          140
        ],
        "nice": false
      },
      "axis": {
        "title": "Visitor nights (millions)",
        "values": [
          0,
          10,
          20,
          30,
          40,
          50,
          70,
          80,
          90,
          100,
          110,
          120
        ],
        "labelExpr": "datum.value >= 70 ? datum.value - 70 : datum.value",
        "grid": false
      }
    },
    "color": {
      "field": "Purpose",
      "type": "nominal",
      "scale": {
        "domain": [
          "Holiday",
          "Visiting friends and relatives",
          "Business",
          "Other"
        ],
        "range": [
          "#0072B2",
          "#D55E00",
          "#009E73",
          "#CC79A7"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "Purpose"
    },
    "tooltip": [
      {
        "field": "Purpose",
        "type": "nominal"
      },
      {
        "field": "DisplayQuarter",
        "type": "ordinal",
        "title": "Quarter"
      },
      {
        "field": "VisitorNightsM",
        "type": "quantitative",
        "title": "Visitor nights (millions)",
        "format": ".2f"
      }
    ]
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.Quarter === 'Jun 2025'"
        },
        {
          "calculate": "[0, 10, 20, 30, 40, 50]",
          "as": "GridTicks"
        },
        {
          "flatten": [
            "GridTicks"
          ]
        },
        {
          "calculate": "datum.PanelBase + datum.GridTicks",
          "as": "GridY"
        },
        {
          "calculate": "datum.PanelColumn + 4",
          "as": "GridEnd"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "PanelColumn",
          "type": "quantitative"
        },
        "x2": {
          "field": "GridEnd"
        },
        "y": {
          "field": "GridY",
          "type": "quantitative"
        },
        "color": {
          "value": "#e2e9ef"
        },
        "tooltip": null
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 65
        }
      },
      "encoding": {
        "order": {
          "field": "QuarterIndex"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Quarter === 'Jun 2025'"
        },
        {
          "calculate": "datum.PanelBase + 65",
          "as": "HeaderY"
        },
        {
          "calculate": "width < 650 && datum.Purpose === 'Visiting friends and relatives' ? 'Visiting friends\\nand relatives' : datum.Purpose",
          "as": "PanelHeading"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": {
          "expr": "width < 650 ? 11 : 14"
        },
        "fontWeight": 600,
        "lineHeight": 15,
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "PanelColumn",
          "type": "quantitative"
        },
        "y": {
          "field": "HeaderY",
          "type": "quantitative"
        },
        "text": {
          "field": "PanelHeading"
        },
        "color": {
          "value": "#183041"
        },
        "tooltip": null
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Segoe UI, Arial, sans-serif",
    "axis": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "gridColor": "#e2e9ef",
      "domainColor": "#b8c6d0",
      "tickColor": "#b8c6d0",
      "domain": false,
      "ticks": false
    },
    "legend": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    },
    "header": {
      "labelFont": "Segoe UI, Arial, sans-serif",
      "titleFont": "Segoe UI, Arial, sans-serif"
    }
  }
}
