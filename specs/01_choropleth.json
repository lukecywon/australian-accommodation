{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Is Domestic Tourism Most Intense Relative to Population?",
    "subtitle": "Domestic visitor nights by state releative to population, year ending June 2026"
  },
  "width": 620,
  "height": 440,
  "data": {
    "url": "data/australia.topojson",
    "format": {
      "type": "topojson",
      "feature": "shapes"
    }
  },
  "transform": [
    {
      "filter": "datum.properties.STE_NAME21 != 'Other Territories'"
    },
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "data/tourism_by_state_with_population.csv"
        },
        "key": "State",
        "fields": [
          "DomesticNightsM",
          "Population"
        ]
      }
    },
    {
      "calculate": "datum.Population > 0 ? datum.DomesticNightsM * 1000000 / datum.Population : null",
      "as": "NightsPerResident"
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.8
  },
  "encoding": {
    "color": {
      "field": "NightsPerResident",
      "type": "quantitative",
      "scale": {
        "scheme": "blues"
      },
      "title": "Visitor nights per resident"
    },
    "tooltip": [
      {
        "field": "properties.STE_NAME21",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "NightsPerResident",
        "type": "quantitative",
        "title": "Visitor Nights Per Resident",
        "format": ".1f"
      },
      {
        "field": "DomesticNightsM",
        "type": "quantitative",
        "title": "Domestic nights (millions)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
